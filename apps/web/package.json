{
  "name": "@pago/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "android:sync": "npm run build && npx cap sync android",
    "android:apk": "npm run android:sync && cd android && set \"GRADLE_OPTS=-Djavax.net.ssl.trustStoreType=Windows-ROOT\" && gradlew assembleDebug",
    "android:install": "adb install -r android/app/build/outputs/apk/debug/app-debug.apk"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.6.2",
    "@capgo/capacitor-native-biometric": "^8.9.3",
    "@pago/shared": "*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "vite": "^8.3.8"
  }
}
