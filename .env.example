# Copiază acest fișier ca `.env` (care NU intră în git) și completează valorile.

# Ce model folosește asistentul:
#   "mock"   = răspunsuri scriptate (fără cheie)
#   "groq"   = Llama 3.3 70B prin Groq (gratuit, cere GROQ_API_KEY)
#   "claude" = Claude (cere ANTHROPIC_API_KEY)
# Dacă lipsește cheia pentru modul ales, agentul rulează cu modelul simulat.
LLM_MODE=mock

# Groq (cheie gratuită: https://console.groq.com/keys)
GROQ_API_KEY=
# Modelul Groq (implicit: openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b

# Anthropic
ANTHROPIC_API_KEY=
# Modelul Claude folosit când LLM_MODE=claude (implicit: claude-sonnet-5-5)
LLM_MODEL=claude-sonnet-5-5

# Portul serverului (frontend-ul trimite /api către el)
SERVER_PORT=3001
