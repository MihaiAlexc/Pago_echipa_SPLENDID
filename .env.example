# Copiază acest fișier ca `.env` (care NU intră în git) și completează valorile.

# Cheia API Anthropic. Dacă lipsește, agentul rulează cu modelul simulat.
ANTHROPIC_API_KEY=

# "mock" = răspunsuri scriptate (fără cheie), "claude" = modelul real
LLM_MODE=mock

# Modelul Claude folosit când LLM_MODE=claude (implicit: claude-sonnet-5-5)
LLM_MODEL=claude-sonnet-5-5

# Portul serverului (frontend-ul trimite /api către el)
SERVER_PORT=3001
