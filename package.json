{
  "name": "pago-voice-assistant",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev -w @pago/server\" \"npm run dev -w @pago/web\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:llm": "vitest run --config vitest.llm.config.ts",
    "tunnel": "cloudflared tunnel --url http://localhost:5173 --no-autoupdate",
    "build": "npm run build -w @pago/server && npm run build -w @pago/web"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
